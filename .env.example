# PostgreSQL. Local Docker matches docker-compose.yml.
# Production: managed PostgreSQL connection string. Prefer sslmode=require.
# Example production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/luma?schema=public&sslmode=require"
DATABASE_URL="postgresql://luma:luma@localhost:5432/luma?schema=public"

# Max connections this Node process opens. Keep low (1–5) behind a pooler / on serverless.
# DATABASE_POOL_MAX="10"

# Auth.js. Generate a production secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never reuse the development placeholder in production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Canonical public origin of the shop (no trailing slash). Used for Auth.js, metadata, sitemap, www redirects.
# Local:
AUTH_URL="http://localhost:3000"
# Production (set both; APP_ORIGIN wins for canonical URLs):
# APP_ORIGIN="https://luma.ge"
# AUTH_URL="https://luma.ge"

# Rate-limit store: memory (single process, default in development) or postgres (default in production).
# RATE_LIMIT_STORE="postgres"

# Optional extra next/image hosts, comma-separated (R2_PUBLIC_URL is added automatically).
# IMAGE_REMOTE_HOSTS="images.luma.ge"

# Set true only if you must send HSTS while APP_ORIGIN is still http (not recommended).
# ENABLE_HSTS="false"

# Cloudflare R2. Leave unset until a bucket exists. Storefront keeps working without them.
# Production custom domain example: R2_PUBLIC_URL="https://images.luma.ge"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# Catalogue seed wipes product tables. Never set this in production unless you intend a rebuild.
# ALLOW_PRODUCTION_SEED="false"

# Bank of Georgia standard card payments. Leave unset locally until credentials exist.
# The shop keeps working; card checkout then shows a configuration error (payments are not faked).
# BOG_PAYMENTS_ENABLED="false"
# BOG_CLIENT_ID=""
# BOG_CLIENT_SECRET=""
# BOG_OAUTH_URL="https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token"
# BOG_API_BASE_URL="https://api.bog.ge"

# Transactional email (Resend). Leave unset locally until you have a key.
# The shop, checkout, and auth keep working; sends log email.not_configured (not faked as success).
# Production sender must be a verified domain, e.g. Luma <noreply@luma.ge>
# RESEND_API_KEY=""
# EMAIL_FROM="Luma <noreply@luma.ge>"
# EMAIL_REPLY_TO="Luma <info@luma.ge>"
# Local-only redirect of every transactional email. Ignored in production unless EMAIL_ALLOW_OVERRIDE=true.
# EMAIL_OVERRIDE_TO="you@example.com"
# EMAIL_ALLOW_OVERRIDE="false"
